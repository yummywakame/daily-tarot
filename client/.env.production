# Loaded automatically by Vite during `npm run build`.
# The live site serves from the domain root, so no VITE_BASE_PATH is needed (assets use /).
# To serve from a subpath instead, set VITE_BASE_PATH=/sub/path/ here and APP_BASE=/sub/path on the server.

# Full public URL of the site, used for the social preview (Open Graph) tags in index.html
VITE_SITE_URL=https://dailytarot.yummywakame.com
