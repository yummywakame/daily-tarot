# Loaded automatically by Vite during `npm run build`.
# Sets the asset base path for the Mochahost subpath deployment.
# Do NOT set this for local dev builds — leave those without this file active.
VITE_BASE_PATH=/demos/daily-tarot/

# Full public URL of the site, used for the social preview (Open Graph) tags in index.html
VITE_SITE_URL=https://yummy-wakame.com/demos/daily-tarot
