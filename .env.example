MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME
SECRET=your_jwt_secret_here_make_it_long_and_random
PORT=7000
NODE_ENV=development

# Only needed to serve the app from a subpath (e.g. https://yourdomain.com/some/path/):
# set APP_BASE to that path with NO trailing slash, and build the client with a matching
# VITE_BASE_PATH (/some/path/). Leave empty to serve from the domain root (local and live).
APP_BASE=
